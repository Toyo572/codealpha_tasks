DEBUG=True
SECRET_KEY=django-insecure-change-this-to-a-long-random-string-in-production
DATABASE_URL=postgres://postgres:password@localhost:5432/restaurant_db
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# Admin registration secret — required to create admin accounts via API
ADMIN_REGISTRATION_SECRET=my-super-secret-admin-key-2025

# JWT token lifetimes
JWT_ACCESS_TOKEN_LIFETIME_DAYS=1
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# Frontend URL — used in staff invitation emails
FRONTEND_URL=http://localhost:8000

# Email — use console for dev (prints to terminal), smtp for production
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=Restaurant App <noreply@restaurant.com>